<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Top Image -->
    <ImageView
        android:id="@+id/topImage"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:scaleType="centerCrop"
        android:src="@drawable/slider3" />

    <!-- Grid Buttons -->
    <GridLayout
        android:id="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/topImage"
        android:layout_marginBottom="-50dp"
        android:columnCount="4"
        android:alignmentMode="alignMargins"
        android:rowOrderPreserved="false"
        android:useDefaultMargins="true"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <!-- Event Button -->
        <LinearLayout
            android:id="@+id/exploreButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_margin="10dp"
            android:background="@drawable/rounded_corners">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/event_button_home"
                android:contentDescription="Events"
                android:scaleType="fitCenter"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Events"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Saved Button -->
        <LinearLayout
            android:id="@+id/savedEventsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_margin="10dp"
            android:background="@drawable/rounded_corners">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/saves_button_home"
                android:contentDescription="Saved"
                android:scaleType="fitCenter"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Ticket Button -->
        <LinearLayout
            android:id="@+id/getTicketButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_margin="10dp"
            android:background="@drawable/rounded_corners">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/ticket_button_home"
                android:contentDescription="Ticket"
                android:scaleType="fitCenter"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ticket"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- News Button -->
        <LinearLayout
            android:id="@+id/bookEventButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingVertical="6dp"
            android:paddingHorizontal="4dp"
            android:layout_margin="10dp"
            android:background="@drawable/rounded_corners">

            <ImageView
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:src="@drawable/news"
                android:contentDescription="News"
                android:scaleType="fitCenter"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="News"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

    </GridLayout>

    <ScrollView
        android:layout_below="@+id/buttonContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="70dp"
        android:scrollbars="none"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Slider -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/autoSliderHome"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="16dp"/>

            <!-- Banner Section -->
            <LinearLayout
                android:id="@+id/bannerall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:background="@drawable/rounded_corners">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:text="What's Happening In Dhaka"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/seeAllText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:gravity="end"
                        android:text="See all"
                        android:textColor="@color/purple_700"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <androidx.viewpager2.widget.ViewPager2
                    android:id="@+id/bannerViewPager"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:clipChildren="false"
                    android:paddingEnd="30dp"
                    android:clipToPadding="false"
                    android:clickable="true"/>
            </LinearLayout>

            <!-- Four News Sections Grid -->

            <!-- What's Hot Right Now Section -->
            <LinearLayout
                android:id="@+id/whatsHotSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="150dp"
                android:background="@drawable/rounded_corners"
                android:padding="10dp">

                <!-- Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="1"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:text="What's Hot Right Now"
                        android:textColor="@android:color/black"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:paddingStart="10dp"/>

                    <TextView
                        android:id="@+id/seeAllHot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"
                        android:gravity="end"
                        android:text="See all"
                        android:textColor="@color/purple_700"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:paddingEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- 2x2 News Grid -->
                <GridLayout
                    android:id="@+id/sectionGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2"
                    android:layout_marginTop="10dp"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true"
                    android:gravity="center">

                    <!-- Top-left -->
                    <LinearLayout
                        android:id="@+id/gridTopLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|start"
                        android:background="@drawable/news_item_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/gridTopLeftText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Top-right -->
                    <LinearLayout
                        android:id="@+id/gridTopRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|start"
                        android:background="@drawable/news_item_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/gridTopRightText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Bottom-left -->
                    <LinearLayout
                        android:id="@+id/gridBottomLeft"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|start"
                        android:background="@drawable/news_item_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/gridBottomLeftText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                    <!-- Bottom-right -->
                    <LinearLayout
                        android:id="@+id/gridBottomRight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical|start"
                        android:background="@drawable/news_item_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/gridBottomRightText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/black"
                            android:textStyle="bold"
                            android:textSize="12sp"/>
                    </LinearLayout>

                </GridLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>





</RelativeLayout>
